{
  "name": "meditation-posture-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "HTTPS=1 vite --host",
    "build": "npm run setup && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/fetch-models.mjs && node scripts/copy-wasm.mjs",
    "setup": "node scripts/fetch-models.mjs && node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
